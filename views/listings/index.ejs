<% layout("/layouts/boilerplate") %>

    <style>
        #filters {
            text-decoration: none;
            margin-top: 2rem;
            margin-bottom: 2rem;
            display: flex;
            justify-content: space-evenly;
            
        }

        .filter {
            border: none;
            text-align: center;
            
            margin-left: 2rem;
            opacity: 0.7;
        }

        .filter:hover {
            opacity: 1;
        }



        .setting:hover {
            height: 50px;
            border: 2px solid black;
            border-radius: 10px;
            padding: 0px 30px 0px;
            opacity: 1;
        }

        .border1 {

            padding: 10px 40px 40px;
        }

        .border1:hover {
            height: 50px;
            text-align: center;

            border-radius: 10px;

            border: 2px solid black;
        }

        .tax-info {
            display: none;
        }
    </style>

    <body>
        <div id="filters">
            <div class="filter">
                <a href="/category/icons"><i class="fa-solid fa-ticket-simple" style="color: black;"></i></a>
                <p >
                    <a href="/category/icons" style="text-decoration: none; color: black;">icons</a>
                </p>

            </div>
            
            <div class="filter">
                <a href="/category/Arctic"><i class="fa-solid fa-snowflake" style="color: black;"></i></a>
                <p style="text-decoration: none;">
                    <a href="/category/Arctic" style="text-decoration: none; color: black;">Arctic</a>
                </p>

            </div>
            <div class="filter">
                <a href="/category/Trending"><i class="fa-solid fa-fire" style="color: black;"></i></a>
                <p style="text-decoration: none;">
                    <a href="/category/Trending" style="text-decoration: none; color: black;">Trending</a>
                </p>

            </div>
            <div class="filter">
                <a href="/category/Lake"><i class="fa-solid fa-water" style="color: black;"></i></a>
                <p style="text-decoration: none;">
                    <a href="/category/Lake" style="text-decoration: none; color: black;">Lake</a>
                </p>

            </div>
            <div class="filter">
                <a href="/category/Beach"><i class="fa-solid fa-umbrella-beach" style="color: black;"></i></a>
                <p style="text-decoration: none;">
                    <a href="/category/Beach" style="text-decoration: none; color: black;">Beach</a>
                </p>

            </div>
            <div class="filter">
                <a href="/category/OMG">
                <i class="fa-solid fa-satellite" style="color: black;"></i></a>
                <p style="text-decoration: none;">
                    <a href="/category/OMG" style="text-decoration: none; color: black;">OMG</a>
                </p>
            </a>
            </div>
            <div class="filter">
                <a href="/category/Bed&Breakfast"><i class="fa-solid fa-mug-hot" style="color: black;"></i></a>
                <p style="text-decoration: none;">
                    <a href="/category/Bed&Breakfast" style="text-decoration: none; color: black;">Bed&Breakfast</a>
                </p>

            </div>
            <div class="filter">
                <a href="/category/Farm"><i class="fa-solid fa-cow" style="color: black;"></i></a>
                <p >
                    <a href="/category/Farm" style="text-decoration: none; color: black;">Farm</a>
                </p>

            </div>

     

        </div>

        <!-- <h3><form method="get" action="/listings/new">
        <button>Create new post</button>
    </form></h3> -->

        <div class="row row-cols-lg-4 row-cols-md-2 row-cols-sm-1">
            <% for(let listing of allListing){ %>
                <a href="/listings/<%= listing._id %>" class="card-link">
                    <div class="card col listing-card">
                        <img class="card-img-top" src="<%= (listing.image && listing.image.url) ? listing.image.url : 'https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=800&q=60' %>" alt="Card image cap" style=" height:
                            18rem;">
                        <div class="card-body">
                            <p class="card-text-title">
                                <%= listing.title%>
                            </p>
                            <!-- <p class="card-text"><%= listing.description%></p> -->
                            <p class="card-text"><i class="fa fa-inr"></i>
                                <%= listing.price.toLocaleString("en-IN")%>
                                    <i class="tax-info"> &nbsp; &nbsp; +18% GST</i>
                            </p>
                        </div>
                    </div>
                    <%}%>
        </div>



    </body>


    <script>
        let getswitch = document.getElementById("flexSwitchCheckDefault");

        console.log(getswitch);
        getswitch.addEventListener("click", () => {

            let element = document.getElementsByClassName("tax-info");
            // Iterate over the HTMLCollection


            for (info of element) {
                if (info.style.display != "inline") {
                    info.style.display = "inline";
                } else {
                    info.style.display = "none";
                }


            }

        });


    </script>