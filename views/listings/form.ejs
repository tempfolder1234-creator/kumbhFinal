<% layout("/layouts/boilerplate") %>

<body>
  <div class="form-container">
    <h3>Create New Listings</h3>
    <div class="row justify-content-center">
      <div class="col-md-8">
        <form method="post" action="/listings" novalidate class="needs-validation" enctype="multipart/form-data">
          <div class="mt-3">
            <label for="title" class="form-label">Title</label>
            <input type="text" name="listing[title]" placeholder="Enter the Title" class="form-control" required>
            <div class="invalid-feedback">Please Enter the Title</div>
            <div class="valid-feedback">Title looks good</div>
          </div>

          <div class="mt-3">
            <label for="description" class="form-label">Description</label>
            <textarea name="listing[description]" placeholder="Enter the description" class="form-control" required></textarea>
            <div class="invalid-feedback">Description should be valid</div>
          </div>

          <div class="mt-3">
            <label for="image" class="form-label">Upload Image</label>
            <input type="file" name="listing[image]" class="form-control">
          </div>

          <div class="mt-3">
            <label for="price" class="form-label">Price</label>
            <input type="text" name="listing[price]" placeholder="Enter the price" class="form-control" required>
            <div class="invalid-feedback">Price should be valid</div>
          </div>

          <div class="row mt-3">
            <div class="col-md-4">
              <label for="country" class="form-label">Country</label>
              <input type="text" name="listing[country]" placeholder="Enter the country" class="form-control" required>
              <div class="invalid-feedback">Country should be valid</div>
            </div>

            <div class="col-md-8">
              <label for="location" class="form-label">Location</label>
              <input type="text" name="listing[location]" placeholder="Enter the Location" class="form-control" required>
              <div class="invalid-feedback">Location should be valid</div>
            </div>
          </div>
          <br>
          <div class="mb-3">
            <label for="category" class="form-label" style="font-size: 18px;">Category</label>
            <select name="listing[category]" class="form-select" required>
              <option value="" disabled selected>Select a category</option>
              <option value="Trending">Trending</option>
              <option value="icons">icons</option>
              <option value="Beach">Beach</option>
              <option value="OMG">OMG</option>
              <option value="Lake">Lake</option>
              <option value="Bed&Breakfast">Bed&Breakfast</option>
              <option value="Farm">Farm</option>
              <option value="Arctic">Arctic</option>
            </select>
            <div class="invalid-feedback">Please select a category</div>
          </div>

          <!-- New Features Checkboxes -->
          <div class="mb-3">
            <label class="form-label" style="font-size: 18px;">Features</label>
            <div class="row">
              <!-- Left-side Features List -->
              <div class="col-md-6">
                <div class="form-check">
                  <input class="form-check-input" type="checkbox" name="listing[features]" value="Free Parking" id="FreeParking">
                  <label class="form-check-label" for="FreeParking">
                    Free Parking &nbsp;&nbsp;<i class="fa-solid fa-car"></i>
                  </label>
                </div>
                <div class="form-check">
                  <input class="form-check-input" type="checkbox" name="listing[features]" value="WiFi" id="WiFi">
                  <label class="form-check-label" for="WiFi">
                    WiFi &nbsp;&nbsp;<i class="fa-solid fa-wifi"></i>
                  </label>
                </div>
                <div class="form-check">
                  <input class="form-check-input" type="checkbox" name="listing[features]" value="Hot Water" id="HotWater">
                  <label class="form-check-label" for="HotWater">
                    Hot Water &nbsp;&nbsp;<i class="fa-solid fa-water"></i>
                  </label>
                </div>
                <div class="form-check">
                  <input class="form-check-input" type="checkbox" name="listing[features]" value="24 hrs Electricity" id="Electricity">
                  <label class="form-check-label" for="Electricity">
                    24 hrs Electricity &nbsp;&nbsp;<i class="fa-solid fa-bolt"></i>
                  </label>
                </div>
                <div class="form-check">
                  <input class="form-check-input" type="checkbox" name="listing[features]" value="Security Guard" id="SecurityGuard">
                  <label class="form-check-label" for="SecurityGuard">
                    Security Guard &nbsp;&nbsp;<i class="fa-solid fa-person-military-pointing"></i>
                  </label>
                </div>
              </div>

              <!-- Right-side Features List -->
              <div class="col-md-6">
                <div class="form-check">
                  <input class="form-check-input" type="checkbox" name="listing[features]" value="Balcony" id="Balcony">
                  <label class="form-check-label" for="Balcony">
                    Balcony &nbsp;&nbsp;<i class="fa-brands fa-windows"></i>
                  </label>
                </div>
                <div class="form-check">
                  <input class="form-check-input" type="checkbox" name="listing[features]" value="Kitchen" id="Kitchen">
                  <label class="form-check-label" for="Kitchen">
                    Kitchen &nbsp;&nbsp;<i class="fa-solid fa-kitchen-set"></i>
                  </label>
                </div>
                <div class="form-check">
                  <input class="form-check-input" type="checkbox" name="listing[features]" value="Gym" id="Gym">
                  <label class="form-check-label" for="Gym">
                    Gym &nbsp;&nbsp;<i class="fa-solid fa-dumbbell"></i>
                  </label>
                </div>
                <div class="form-check">
                  <input class="form-check-input" type="checkbox" name="listing[features]" value="Furniture" id="Furniture">
                  <label class="form-check-label" for="Furniture">
                    Furniture &nbsp;&nbsp;<i class="fa-solid fa-chair"></i>
                  </label>
                </div>
              </div>
            </div>
          </div>

          <button class="btn add-btn mt-4">Add</button>
        </form>
      </div>
    </div>
  </div>
</body>

<link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/css/bootstrap.min.css" rel="stylesheet">
<style>
  /* Overall body styling with a background image */
  body {
    background: url('/images/nature.jpg') no-repeat center center fixed;
    background-size: cover;
    font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
    margin: 0;
    padding: 0;
  }

  /* Form container styling with transparency */
  .form-container {
    background: rgba(255, 255, 255, 0.85);
    padding: 2rem;
    margin: 2rem auto;
    border-radius: 10px;
    box-shadow: 0 8px 16px rgba(0, 0, 0, 0.1);
    max-width: 800px;
  }

  /* Heading styling */
  h3 {
    text-align: center;
    font-weight: 600;
    color: #333;
    margin-bottom: 1.5rem;
    position: relative;
  }
  
  h3::after {
    content: "";
    width: 60px;
    height: 3px;
    background: #6dd5ed;
    display: block;
    margin: 10px auto 0;
    border-radius: 2px;
  }

  /* Form label styling */
  .form-label {
    font-weight: 500;
    color: #555;
  }

  /* Input and textarea styling */
  .form-control {
    border-radius: 5px;
    border: 1px solid #ddd;
    transition: border-color 0.3s, box-shadow 0.3s;
  }

  .form-control:focus {
    border-color: #6dd5ed;
    box-shadow: 0 0 8px rgba(109, 213, 237, 0.5);
  }

  /* Button styling */
  .btn.add-btn {
    background: #6dd5ed;
    border: none;
    color: #fff;
    padding: 0.75rem 1.5rem;
    font-size: 1rem;
    border-radius: 5px;
    transition: background 0.3s, transform 0.3s;
    width: 100%;
    display: block;
  }

  .btn.add-btn:hover {
    background: #57c0d4;
    transform: translateY(-2px);
  }

  /* File input padding */
  input[type="file"].form-control {
    padding: 0.375rem 0.75rem;
  }

  /* Feedback text sizing */
  .invalid-feedback,
  .valid-feedback {
    font-size: 0.9rem;
  }

  /* Checkbox styling for features */
  .form-check {
    margin-bottom: 0.5rem;
  }

  .form-check-input {
    margin-top: 0.3rem;
  }


</style>
