<% layout("/layouts/boilerplate") %>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap');

  :root {
    --primary-color: #4A90E2;
    --secondary-color: #50E3C2;
    --light-bg: #ffffff;
    --text-color: #333;
    --subtext-color: #777;
  }

  body {
    font-family: 'Poppins', sans-serif;
    /* Replace YOUR_BACKGROUND_IMAGE_URL_HERE with your preferred background image URL */
    background: url('/images/black.jpg') no-repeat center center fixed;
    
    background-size: cover;
    margin: 0;
    padding: 0;
  }

  /* Overlay for better readability */
  .overlay {
    background: rgba(255, 255, 255, 0.9);
    min-height: 100vh;
    padding: 2rem 0;
  }

  /* Main container */
  .profile-page-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem;
  }

  /* Profile Card */
  .profile-card {
    display: flex;
    background: var(--light-bg);
    border-radius: 12px;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
    overflow: hidden;
    margin-bottom: 2rem;
  }
  .profile-image-container {
    flex: 0 0 250px;
    background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: 2rem;
    position: relative;
  }
  .profile-img {
    width: 150px;
    height: 150px;
    border-radius: 50%;
    border: 5px solid var(--light-bg);
    object-fit: cover;
  }
  .photo-form {
    margin-top: 1rem;
  }
  .photo-form button {
    padding: 0.5rem 1rem;
    font-size: 0.9rem;
    border: 1px solid var(--light-bg);
    background: transparent;
    color: var(--light-bg);
    border-radius: 20px;
    cursor: pointer;
    transition: background 0.3s, color 0.3s;
  }
  .photo-form button:hover {
    background: var(--light-bg);
    color: var(--primary-color);
  }
  .profile-details {
    flex: 1;
    padding: 2rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .profile-details h4 {
    margin: 0 0 0.5rem;
    font-size: 28px;
    font-weight: 600;
    color: var(--text-color);
    border-bottom: 2px solid var(--primary-color);
    padding-bottom: 0.5rem;
  }
  .profile-details p {
    margin: 0.3rem 0;
    font-size: 16px;
    color: var(--subtext-color);
  }

  /* Bookings Section */
  .bookings-section {
    background: var(--light-bg);
    border-radius: 12px;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
    padding: 2rem;
  }
  .bookings-header {
    font-size: 22px;
    font-weight: 600;
    color: var(--text-color);
    margin-bottom: 1rem;
    text-align: center;
    border-bottom: 2px solid var(--primary-color);
    padding-bottom: 0.5rem;
  }
  .table-responsive {
    margin-top: 1rem;
  }
  table.table {
    width: 100%;
    border-collapse: collapse;
  }
  table.table th, table.table td {
    padding: 1rem;
    text-align: center;
    border-bottom: 1px solid #e3e6f0;
  }
  table.table thead {
    background: #f9fafb;
    color: var(--text-color);
  }
  table.table tbody tr:hover {
    background: #f1f5f9;
  }
  .btn-danger {
    background-color: #e74c3c;
    border: none;
    color: #fff;
    padding: 0.5rem 1rem;
    border-radius: 4px;
    cursor: pointer;
    transition: background 0.3s, transform 0.3s;
  }
  .btn-danger:hover {
    background-color: #c0392b;
    transform: scale(1.05);
  }
</style>

<div class="overlay">
  <div class="container profile-page-container">
    <!-- Profile Card -->
    <div class="profile-card">
      <div class="profile-image-container">
        <img src="https://png.pngtree.com/png-clipart/20220213/original/pngtree-avatar-bussinesman-man-profile-icon-vector-illustration-png-image_7268049.png" 
             alt="User Image" class="profile-img" id="currentProfileImg">
        <!-- Photo Update Form -->
        <form class="photo-form" method="POST" enctype="multipart/form-data">
          <input type="file" name="profilePhoto" accept="image/*" id="photoInput" style="display: none;">
          <button type="button" id="changePhotoBtn">Change Photo</button>
        </form>
      </div>
      <div class="profile-details">
        <h4>Welcome to your profile, <%= user ? user.username : "Guest" %></h4>
        <p>Email: <%= user ? user.email : "N/A" %></p>
        
      </div>
    </div>

    <!-- Bookings Section -->
    <div class="bookings-section">
      <div class="bookings-header">
        Your Upcoming Bookings
      </div>
      <div class="table-responsive">
        <table class="table table-hover">
          <thead>
            <tr>
              <th>Listing Name</th>
              <th>Start Date</th>
              <th>End Date</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if (!bookings || bookings.length === 0) { %>
              <tr>
                <td colspan="4" class="text-center" style="color: var(--subtext-color);">No bookings yet. Start your journey now!</td>
              </tr>
            <% } else { %>
              <% bookings.forEach(booking => { %>
                <tr>
                  <td>
                    <%= booking.listing ? booking.listing.title : "Unknown Listing" %>
                  </td>
                  <td>
                    <%= new Date(booking.startDate).toDateString() %>
                  </td>
                  <td>
                    <%= new Date(booking.endDate).toDateString() %>
                  </td>
                  <td>
                    <form action="/booking/<%= booking._id %>?_method=DELETE" method="POST">
                      <button type="submit" class="btn-danger">Cancel</button>
                    </form>
                  </td>
                </tr>
              <% }) %>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<script>
  // Set currentUserId using the logged in user's ID; if not logged in, use 'guest'
  var currentUserId = "<%= user ? user._id : 'guest' %>";
  var storageKey = "profilePhoto_" + currentUserId;

  // On page load, check if a profile photo for this user is stored in localStorage and update the preview
  document.addEventListener("DOMContentLoaded", function() {
    var storedPhoto = localStorage.getItem(storageKey);
    if (storedPhoto) {
      document.getElementById('currentProfileImg').src = storedPhoto;
    }
  });

  // Trigger the file input when "Change Photo" is clicked
  document.getElementById('changePhotoBtn').addEventListener('click', function() {
    document.getElementById('photoInput').click();
  });

  // Update the profile image preview and store it in localStorage when a new file is selected
  document.getElementById('photoInput').addEventListener('change', function() {
    if (this.files && this.files[0]) {
      var reader = new FileReader();
      reader.onload = function(e) {
        document.getElementById('currentProfileImg').src = e.target.result;
        localStorage.setItem(storageKey, e.target.result);
      };
      reader.readAsDataURL(this.files[0]);
    }
  });
</script>  